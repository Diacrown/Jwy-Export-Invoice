# Supabase project settings. Copy to .env and fill in from your project dashboard.
# These values ARE shipped to the browser bundle — do NOT put service-role keys here.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Storage bucket names (create as private buckets in the Supabase dashboard).
VITE_BUCKET_RAW_SJ50=raw-sj50
VITE_BUCKET_VENDOR_SDJJB=vendor-sdjjb
VITE_BUCKET_GENERATED=generated-invoices
